<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.projectjuansantiagoaby.ui.fragment.HomeFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.projectjuansantiagoaby.ui.fragment.LoginFragment"
        android:label="Inicio de Sesión"
        tools:layout="@layout/fragment_login" />

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.projectjuansantiagoaby.ui.fragment.DetailFragment"
        android:label="Detalle"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="animeLink"
            app:argType="string" />
        <action
            android:id="@+id/action_detailFragment_to_playerFragment"
            app:destination="@id/playerFragment" />
    </fragment>

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.example.projectjuansantiagoaby.ui.fragment.PlayerFragment"
        android:label="Reproductor"
        tools:layout="@layout/fragment_player">
        <argument
            android:name="episodeLink"
            app:argType="string" />
        <argument
            android:name="animeTitle"
            app:argType="string" />
    </fragment>

</navigation>
